<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Twentytoo{% endblock %}</title>
{# htmx upgrades sort/filter/search/pagination to partial swaps; every control
   degrades to plain HTTP without JS (01 §6.2). Served from CDN for now; the
   framework-owned static-asset pipeline lands in a later slice. #}
<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
<style>
  :root { --accent:#2563eb; --bg:#f6f7f9; --text:#1c2430; --muted:#667085; --border:#e2e6ec; --danger:#dc2626; }
  * { box-sizing:border-box; }
  body { margin:0; font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; background:var(--bg); color:var(--text); }
  .topbar { display:flex; align-items:center; gap:1.25rem; padding:.65rem 1.5rem; background:#fff; border-bottom:1px solid var(--border); }
  .topbar .brand { font-weight:700; text-decoration:none; color:var(--text); }
  .topbar nav { display:flex; gap:1rem; flex:1; }
  .topbar nav a { color:var(--muted); text-decoration:none; }
  .topbar nav a.active { color:var(--accent); font-weight:600; }
  .topbar .actor { color:var(--muted); font-size:.85rem; }
  main { padding:1.5rem; max-width:1100px; margin:0 auto; }
  h1 { font-size:1.35rem; }
  .resource-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem; }
  .btn { display:inline-block; padding:.4rem .8rem; border:1px solid var(--border); border-radius:6px; background:#fff; color:var(--text); text-decoration:none; font-size:.875rem; cursor:pointer; }
  .btn-primary { background:var(--accent); border-color:var(--accent); color:#fff; }
  .btn-danger { color:var(--danger); border-color:var(--danger); }
  table { width:100%; border-collapse:collapse; background:#fff; border:1px solid var(--border); border-radius:8px; }
  th, td { text-align:left; padding:.5rem .75rem; border-bottom:1px solid var(--border); font-size:.875rem; }
  th a { color:inherit; text-decoration:none; }
  th a:hover { text-decoration:underline; }
  td a { color:var(--accent); text-decoration:none; }
  .empty { color:var(--muted); padding:1rem; }
  .pagination { display:flex; gap:.5rem; align-items:center; padding:1rem 0; }
  .pagination a, .pagination .current { padding:.25rem .6rem; border:1px solid var(--border); border-radius:5px; text-decoration:none; background:#fff; color:var(--text); font-size:.85rem; }
  .pagination .current { background:var(--accent); color:#fff; border-color:var(--accent); }
  .pagination .off { color:var(--muted); padding:.25rem .6rem; }
  .toolbar { display:flex; gap:.75rem; flex-wrap:wrap; align-items:flex-end; margin-bottom:1rem; }
  .toolbar input[type=search], .toolbar input[type=text], .toolbar select { padding:.4rem .6rem; border:1px solid var(--border); border-radius:6px; font:inherit; }
  .badge { display:inline-block; padding:.15rem .5rem; border-radius:999px; font-size:.75rem; background:#eef2ff; color:#3730a3; }
  .detail { background:#fff; border:1px solid var(--border); border-radius:8px; padding:1rem 1.25rem; }
  .detail dt { font-weight:600; font-size:.8rem; color:var(--muted); margin-top:.75rem; }
  .detail dd { margin:.1rem 0 0; }
  .form { background:#fff; border:1px solid var(--border); border-radius:8px; padding:1.25rem; max-width:640px; }
  .field { margin-bottom:1rem; }
  .field label { display:block; font-size:.85rem; font-weight:600; margin-bottom:.3rem; }
  .field .req { color:var(--danger); }
  .field input, .field select, .field textarea { width:100%; padding:.45rem .6rem; border:1px solid var(--border); border-radius:6px; font:inherit; }
  .field.has-error input, .field.has-error select { border-color:var(--danger); }
  .field-error { color:var(--danger); font-size:.8rem; margin:.25rem 0 0; }
  .alert { padding:.6rem .9rem; border-radius:6px; margin-bottom:1rem; font-size:.875rem; }
  .alert.error { background:#fef2f2; color:var(--danger); border:1px solid #fecaca; }
  .form-actions { display:flex; gap:.75rem; }
  .card-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:1rem; }
  .card { display:block; background:#fff; border:1px solid var(--border); border-radius:8px; padding:1.25rem; text-decoration:none; color:var(--text); }
  .card h2 { margin:0 0 .5rem; font-size:1rem; }
  .card .count { margin:0; color:var(--muted); }
</style>
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">Twentytoo</a>
  <nav>
    <a href="/" {% if active == "home" %}class="active"{% endif %}>Home</a>
    {% for item in nav %}
      <a href="/{{ item.key }}" {% if active == item.key %}class="active"{% endif %}>{{ item.label }}</a>
    {% endfor %}
  </nav>
  <span class="actor">{{ actor.email }}</span>
</header>
<main>
  {% block content %}{% endblock %}
</main>
</body>
</html>
