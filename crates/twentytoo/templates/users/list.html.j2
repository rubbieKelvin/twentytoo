{# The Users area list: framework-owned accounts behind users.view. Rows
   link to the edit screen. #}
{% extends "layout/base.html.j2" %}

{% block title %}Users — Twentytoo{% endblock %}

{% block content %}
<div class="resource-header">
  <h1>Users</h1>
  {% if can_create %}
    <a href="/users/new" class="btn btn-primary">New user</a>
  {% endif %}
</div>

<table>
  <thead>
    <tr>
      <th>Email</th>
      <th>Name</th>
      <th>Status</th>
      <th>Created</th>
    </tr>
  </thead>
  <tbody>
    {% for user in users %}
      <tr>
        <td><a href="/users/{{ user.id }}">{{ user.email }}</a></td>
        <td>{{ user.name }}</td>
        <td><span class="badge">{{ user.status }}</span></td>
        <td>{{ user.created_at|format_datetime("%b %d, %Y") }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>

{% if not users %}
  <p class="empty">No users yet.</p>
{% endif %}
{% endblock %}
