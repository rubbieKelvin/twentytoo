{# Shared create/edit form page: a thin wrapper around the form fragment.
   `mode` is "create" or "edit"; `values` carries the current field values;
   `errors` maps field names to messages; `form_error` is the entity-level
   error. #}
{% extends "layout/base.html.j2" %}

{% block title %}{% if mode == "create" %}New{% else %}Edit{% endif %} {{ resource.label }} — Twentytoo{% endblock %}

{% block context %}{{ resource.label }}{% endblock %}

{% block content %}
<div class="resource-header">
  <h1>{% if mode == "create" %}New{% else %}Edit{% endif %} {{ resource.label }}</h1>
</div>
{% include "partials/form.html.j2" %}
{% endblock %}
