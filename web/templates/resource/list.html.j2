{# The generated list page (01-ui-kit §8.3): page header + the #list
   partial. Search, filter, sort, and pagination are all plain HTTP —
   the full page reloads with the new query string. #}
{% extends "layout/base.html.j2" %}

{% block title %}{{ resource.label }} — Twentytoo{% endblock %}

{% block page_title %}{{ resource.label }}{% endblock %}

{% block page_actions %}
  {% if resource.can_create %}
    <a href="/resources/{{ resource.key }}/new" class="btn btn-primary">{{ icon("plus", 16) }} New {{ resource.label }}</a>
  {% endif %}
{% endblock %}

{% block content %}
{% include "partials/list.html.j2" %}
{% endblock %}
