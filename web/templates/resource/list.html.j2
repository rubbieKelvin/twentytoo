{# The generated list page (01 §8.3): a thin wrapper around the #list
   fragment, which htmx swaps on search/filter/sort/pagination. #}
{% extends "layout/base.html.j2" %}

{% block title %}{{ resource.label }} — Twentytoo{% endblock %}

{% block context %}{{ resource.label }}{% endblock %}

{% block content %}
<div class="resource-header">
  <h1>{{ resource.label }}</h1>
  {% if resource.can_create %}
    <a href="/{{ resource.key }}/new" class="btn btn--primary">{{ icon("plus", 16) }} New {{ resource.label }}</a>
  {% endif %}
</div>
{% include "partials/list.html.j2" %}
{% endblock %}
