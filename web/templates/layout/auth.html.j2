<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Twentytoo{% endblock %}</title>
{# Standalone shell for the login screens: no topbar/nav — these pages
   render before an actor exists. Shares the framework stylesheet; the
   `.auth-*` classes scope the login panel. #}
<link rel="stylesheet" href="/static/css/app.css">
</head>
<body>
<main class="auth-shell">
  <div class="auth-card">
    <a class="brand" href="/login">Twentytoo</a>
    {% if error %}
      <div class="alert error">{{ error }}</div>
    {% endif %}
    {% block content %}{% endblock %}
  </div>
</main>
</body>
</html>
