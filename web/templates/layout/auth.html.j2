<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Twentytoo{% endblock %}</title>
{# Standalone shell for the login screens: no sidebar/topbar — these pages
   render before an actor exists. Shares the design system; the auth layout
   scopes the centered card (01 §6). #}
<link rel="stylesheet" href="/static/css/tokens.css">
<link rel="stylesheet" href="/static/css/base.css">
<link rel="stylesheet" href="/static/css/layout.css">
<link rel="stylesheet" href="/static/css/components.css">
<link rel="stylesheet" href="/static/css/utilities.css">
</head>
<body>
<main class="auth-shell">
  <div class="auth-card">
    <a class="brand" href="/login">{{ icon("cube", 20) }} Twentytoo</a>
    {% if error %}
      <div class="alert alert--error">{{ error }}</div>
    {% endif %}
    {% block content %}{% endblock %}
  </div>
</main>
</body>
</html>
