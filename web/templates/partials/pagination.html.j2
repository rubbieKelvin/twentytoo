{# Renders exactly one pager: numbered pages when the source can count
   cheaply (Page.total: Some), prev/next otherwise (00 §5.4). Every link
   is a plain HTTP navigation preserving the query string (01-ui-kit
   §7.8). Disabled edges render as `.page-item.disabled` spans so the
   layout never shifts. #}
{% if pager.mode == "numbered" and pager.total_pages > 1 %}
<nav class="ms-auto" aria-label="Pagination">
  <ul class="pagination pagination-sm mb-0">
    <li class="page-item{% if not pager.prev_url %} disabled{% endif %}">
      {% if pager.prev_url %}
        <a class="page-link" href="{{ pager.prev_url }}" aria-label="Previous page">{{ icon("chevron-left", 16) }}</a>
      {% else %}
        <span class="page-link" aria-hidden="true">{{ icon("chevron-left", 16) }}</span>
      {% endif %}
    </li>
    {% for link in pager.page_links %}
      {% if link.page == pager.current %}
        <li class="page-item active"><span class="page-link" aria-current="page">{{ link.page }}</span></li>
      {% else %}
        <li class="page-item"><a class="page-link" href="{{ link.url }}">{{ link.page }}</a></li>
      {% endif %}
    {% endfor %}
    <li class="page-item{% if not pager.next_url %} disabled{% endif %}">
      {% if pager.next_url %}
        <a class="page-link" href="{{ pager.next_url }}" aria-label="Next page">{{ icon("chevron-right", 16) }}</a>
      {% else %}
        <span class="page-link" aria-hidden="true">{{ icon("chevron-right", 16) }}</span>
      {% endif %}
    </li>
  </ul>
</nav>
{% elif pager.mode == "prevnext" and (pager.prev_url or pager.next_url) %}
<nav class="ms-auto" aria-label="Pagination">
  <ul class="pagination pagination-sm mb-0">
    <li class="page-item{% if not pager.prev_url %} disabled{% endif %}">
      {% if pager.prev_url %}
        <a class="page-link" href="{{ pager.prev_url }}" aria-label="Previous page">{{ icon("chevron-left", 16) }} Prev</a>
      {% else %}
        <span class="page-link" aria-hidden="true">{{ icon("chevron-left", 16) }} Prev</span>
      {% endif %}
    </li>
    <li class="page-item{% if not pager.next_url %} disabled{% endif %}">
      {% if pager.next_url %}
        <a class="page-link" href="{{ pager.next_url }}" aria-label="Next page">Next {{ icon("chevron-right", 16) }}</a>
      {% else %}
        <span class="page-link" aria-hidden="true">Next {{ icon("chevron-right", 16) }}</span>
      {% endif %}
    </li>
  </ul>
</nav>
{% endif %}
