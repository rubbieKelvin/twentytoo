{# The form fragment (01 §8.7): posted via htmx and swapped in place;
   422 responses re-render this fragment with field errors (app.js enables
   the swap). Plain posts re-render the whole page instead. #}
<div id="form-region">
  {% if form_error %}
    <div class="alert alert--error">{{ form_error }}</div>
  {% endif %}
  <form method="post" action="{{ form_action }}" class="form" hx-post="{{ form_action }}" hx-target="#form-region" hx-swap="outerHTML" hx-select="#form-region">
    {% for f in resource.form_fields %}
      <div class="field{% if errors[f.name] %} has-error{% endif %}">
        <label for="f-{{ f.name }}">{{ f.label }}{% if f.required %} <span class="req">*</span>{% endif %}</label>
        {{ form_control(f, values) }}
        {% if errors[f.name] %}<p class="field-error">{{ errors[f.name] }}</p>{% endif %}
      </div>
    {% endfor %}
    <div class="form-actions">
      <button type="submit" class="btn btn--primary">{{ icon("check", 16) }} Save<span class="spinner" hx-indicator aria-hidden="true"></span></button>
      <a class="btn" href="/{{ resource.key }}{% if mode == "edit" %}/{{ record_id }}{% endif %}">Cancel</a>
    </div>
  </form>
</div>
