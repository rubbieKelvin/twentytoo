{# The list fragment (01-ui-kit §8.3): toolbar + table + pagination,
   included by the list page. Every control is a plain HTTP form or
   link — search/filter submit the GET form, sort and pagination are
   ordinary links. The URL is the view state: q, filters, sort, and
   page all live in the query string. #}
<div class="card">
  <div class="card-body border-bottom py-2">
    <form class="d-flex flex-wrap align-items-center gap-2" method="get" action="/resources/{{ resource.key }}">
      {% if resource.searchable %}
        <div class="input-icon">
          <input type="search" class="form-control" name="q" value="{{ q|default('') }}" placeholder="Search {{ resource.label }}…">
          <span class="input-icon-addon">{{ icon("search", 16) }}</span>
        </div>
      {% endif %}
      {% for filter in resource.filters %}
        {{ format_filter(filter) }}
      {% endfor %}
      <button type="submit" class="btn btn-primary">{{ icon("filter", 16) }} Apply</button>
    </form>
  </div>

  <div class="table-responsive">
    <table class="table table-vcenter card-table">
      <thead>
        <tr>
          {% for col in resource.columns %}
            <th{% if resource.sortable and col.sortable %} aria-sort="{% if sort_param == col.name %}ascending{% elif sort_param == '-' ~ col.name %}descending{% else %}none{% endif %}"{% endif %}>
              {% if resource.sortable and col.sortable %}
                <a class="text-reset text-decoration-none d-inline-flex align-items-center gap-1"
                   href="/resources/{{ resource.key }}?{{ link_base }}sort={% if sort_param == col.name %}-{% endif %}{{ col.name }}">
                  {{ col.label }}
                  {% if sort_param == col.name %}{{ icon("chevron-down", 12) }}{% elif sort_param == '-' ~ col.name %}{{ icon("chevron-up", 12) }}{% endif %}
                </a>
              {% else %}
                {{ col.label }}
              {% endif %}
            </th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for item in items %}
          <tr>
            {% for col in resource.columns %}
              {% if loop.first %}
                <td><a class="text-reset text-decoration-none" href="/resources/{{ resource.key }}/{{ item.id }}">{{ format_field(item[col.name], col.kind) }}</a></td>
              {% elif col.kind.tag == "number" or col.kind.tag == "currency" %}
                <td class="text-end">{{ format_field(item[col.name], col.kind) }}</td>
              {% else %}
                <td class="text-secondary">{{ format_field(item[col.name], col.kind) }}</td>
              {% endif %}
            {% endfor %}
          </tr>
        {% else %}
          <tr>
            <td colspan="{{ resource.columns|length }}" class="p-0">
              <div class="empty">
                <div class="empty-icon">{{ icon("inbox", 20) }}</div>
                <p class="empty-title">{% if q or has_filters %}No {{ resource.label }} match your filters{% else %}No {{ resource.label }} yet{% endif %}</p>
                {% if q or has_filters %}
                  <div class="empty-action"><a class="btn btn-ghost" href="/resources/{{ resource.key }}">Clear filters</a></div>
                {% elif resource.can_create %}
                  <div class="empty-action"><a class="btn btn-ghost" href="/resources/{{ resource.key }}/new">{{ icon("plus", 14) }} Create the first {{ resource.label }}</a></div>
                {% endif %}
              </div>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if pager.mode == "numbered" or (pager.mode == "prevnext" and (pager.prev_url or pager.next_url)) %}
    <div class="card-footer">
      {% include "partials/pagination.html.j2" %}
    </div>
  {% endif %}
</div>
