{% extends "layout/base.html.j2" %}

{% block title %}Home — Twentytoo{% endblock %}

{% block content %}
<h1>Dashboard</h1>
<div class="card-grid">
  {% for card in cards %}
    <a class="card" href="/{{ card.key }}">
      <h2>{{ card.label }}</h2>
      {% if card.count is not none %}
        <p class="count">{{ card.count }} records</p>
      {% endif %}
      {% if card.can_create %}
        <p class="count">create allowed</p>
      {% endif %}
    </a>
  {% endfor %}
</div>
{% endblock %}
