{% extends "layout/base.html.j2" %}

{% block title %}Home — Twentytoo{% endblock %}

{% block context %}Dashboard{% endblock %}

{% block content %}
<div class="resource-header">
  <h1>Dashboard</h1>
</div>
<div class="card-grid">
  {% for card in cards %}
    <a class="card card--hover" href="/resources/{{ card.key }}">
      <div class="card__icon">{{ icon(card.icon, 20) }}</div>
      <h2 class="card__title">{{ card.label }}</h2>
      {% if card.count is not none %}
        <p class="card__sub">{{ card.count }} records</p>
      {% endif %}
    </a>
  {% endfor %}
</div>
{% endblock %}
