{% extends "layout/base.html.j2" %}

{% block title %}Home — Twentytoo{% endblock %}

{% block page_title %}Dashboard{% endblock %}

{% block content %}
<div class="row row-cards">
  {% for card in cards %}
    <div class="col-sm-6 col-lg-3">
      <a class="card card-link text-reset text-decoration-none" href="/resources/{{ card.key }}">
        <div class="card-body">
          <div class="text-secondary mb-2">{{ icon(card.icon, 20) }}</div>
          <h3 class="card-title mb-1">{{ card.label }}</h3>
          {% if card.count is not none %}
            <p class="text-secondary mb-0">{{ card.count }} records</p>
          {% endif %}
        </div>
      </a>
    </div>
  {% endfor %}
</div>
{% endblock %}
