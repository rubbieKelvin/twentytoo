{# Step 1 of the login flow: the email address. No signup link — accounts
   are created by admins or by domain allowance, never self-service. #}
{% extends "layout/auth.html.j2" %}

{% block title %}Sign in | Twentytoo{% endblock %}

{% block content %}
<h2 class="card-title text-center mb-4">Sign in</h2>
<form method="post" action="/login/email" autocomplete="off">
  <div class="mb-3">
    <label class="form-label" for="email">Email</label>
    <input name="email" id="email" type="email" class="form-control" required autofocus placeholder="you@example.com">
  </div>
  <button type="submit" class="btn btn-primary w-100">Continue</button>
</form>
{% endblock %}
