{# The password step. `mode` is "set" for accounts without a password yet
   (fresh domain-created accounts) and "verify" for everyone else. #}
{% extends "layout/auth.html.j2" %}

{% block title %}
    {% if mode == "set" %}
        Set your password
    {% else %}
        Sign in
    {% endif %}
    | Twentytoo
{% endblock %}

{% block content %}
<h2 class="card-title text-center mb-4">{% if mode == "set" %}Set your password{% else %}Sign in{% endif %}</h2>
<form method="post" action="/login/password" autocomplete="off">
  <div class="mb-3">
    <label class="form-label" for="password">Password</label>
    <input name="password" id="password" type="password" class="form-control" required autofocus>
  </div>
  <button type="submit" class="btn btn-primary w-100">{% if mode == "set" %}Set password{% else %}Sign in{% endif %}</button>
</form>
{% endblock %}
