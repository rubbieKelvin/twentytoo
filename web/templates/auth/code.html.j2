{# The code step (email confirmation on): the 6-digit code emailed to the
   address submitted on the previous screen. #}
{% extends "layout/auth.html.j2" %}

{% block title %}Confirm code | Twentytoo{% endblock %}

{% block content %}
<h2 class="card-title text-center mb-4">Confirm code</h2>
<form method="post" action="/login/code" autocomplete="off">
  <div class="mb-3">
    <label class="form-label" for="code">Login code</label>
    <input name="code" id="code" class="form-control text-center" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autofocus>
  </div>
  <button type="submit" class="btn btn-primary w-100">Confirm code</button>
</form>
{% endblock %}
