{# The shared Users create/edit form page: a thin wrapper around the form
   fragment. Create mode: email/name/password. Edit mode: email (fixed),
   name, status, password (blank = keep current). #}
{% extends "layout/base.html.j2" %}

{% block title %}{% if mode == "create" %}New user{% else %}Edit user{% endif %} — Twentytoo{% endblock %}

{% block context %}Users{% endblock %}

{% block content %}
<div class="resource-header">
  <h1>{% if mode == "create" %}New user{% else %}Edit user{% endif %}</h1>
</div>
{% include "partials/users-form.html.j2" %}
{% endblock %}
